{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hebbian",
  "version": "0.1.0",
  "identifier": "dev.ricardo.hebbian",
  "build": {
    "beforeDevCommand": "cd .. && node node_modules/vite/bin/vite.js --port 1420 --strictPort",
    "beforeBuildCommand": "cd .. && node node_modules/vite/bin/vite.js build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hebbian",
        "width": 1800,
        "height": 1200,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
