{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hebbian",
  "version": "0.1.0",
  "identifier": "dev.ricardo.hebbian",
  "mainBinaryName": "hebbian",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node scripts/gen-build-id.mjs && cargo build --release -p hebcore && bash ../island-mac/build-app.sh release && pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hebbian",
        "width": 1800,
        "height": 1200,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../island-mac/dist/HebIsland.app/": "HebIsland.app/",
      "../../target/release/hebcore": "hebcore"
    }
  }
}
