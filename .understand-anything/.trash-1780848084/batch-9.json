      "type": "class",
      "name": "WsClient",
      "filePath": "apps/desktop/frontend/src/desktop/bridge/transport.ts",
      "lineRange": [40, 161],
      "summary": "WebSocket 客户端（Web 模式专用）：管理单连接生命周期，提供 invoke（JSON-RPC 风格请求/响应）和 listen（事件订阅）。维护 pending Map 追踪飞行中请求，连接断开时统一 reject。",
      "tags": ["WebSocket", "RPC客户端", "事件订阅"],
      "complexity": "complex"
    },
